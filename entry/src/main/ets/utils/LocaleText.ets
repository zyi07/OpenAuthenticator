export function localeCode(selectedLanguage: string, systemLanguage: string): string {
  const language = normalizeSelectedLanguage(selectedLanguage);
  if (language === LANGUAGE_ZH_TW) {
    return 'zh-Hant';
  }
  if (language === LANGUAGE_EN_US) {
    return 'en-US';
  }
  if (language === LANGUAGE_EN_GB) {
    return 'en-GB';
  }
  if (language === LANGUAGE_ZH_CN) {
    return 'zh-Hans';
  }
  return normalizeSystemLanguage(systemLanguage);
}

export function systemLanguageTag(selectedLanguage: string, systemLanguage: string): string {
  const code = localeCode(selectedLanguage, systemLanguage);
  if (code === 'zh-Hant') {
    return 'zh-Hant';
  }
  if (code === 'en-GB') {
    return 'en-GB';
  }
  if (code === 'en-US') {
    return 'en-US';
  }
  return 'zh-Hans';
}

export function translate(text: string, selectedLanguage: string, systemLanguage: string): string {
  const code = localeCode(selectedLanguage, systemLanguage);
  if (code === 'zh-Hant') {
    return ZH_HANT.get(text) ?? text;
  }
  if (code === 'en-US' || code === 'en-GB') {
    return EN.get(text) ?? text;
  }
  return text;
}

function normalizeSystemLanguage(language: string): string {
  const normalized = language.toLowerCase();
  if (normalized.indexOf('hant') >= 0 || normalized.indexOf('tw') >= 0 || normalized.indexOf('hk') >= 0 ||
    normalized.indexOf('mo') >= 0) {
    return 'zh-Hant';
  }
  if (normalized.startsWith('en-gb')) {
    return 'en-GB';
  }
  if (normalized.startsWith('en')) {
    return 'en-US';
  }
  return 'zh-Hans';
}
