export const LANGUAGE_SYSTEM: string = '跟随系统';
export const LANGUAGE_ZH_CN: string = '简体中文';
export const LANGUAGE_ZH_TW: string = '繁体中文';
export const LANGUAGE_EN_US: string = 'English(US)';
export const LANGUAGE_EN_GB: string = 'English(UK)';

export function normalizeSelectedLanguage(language: string): string {
  const value = language.trim();
  const normalized = value.toLowerCase();
  if (value === LANGUAGE_SYSTEM || value === '跟隨系統' || normalized === 'follow system' || normalized === 'system') {
    return LANGUAGE_SYSTEM;
  }
  if (value === LANGUAGE_ZH_CN ||
    value === '簡體中文' ||
    normalized === 'simplified chinese' ||
    normalized === 'zh-cn' ||
    normalized === 'zh-hans' ||
    normalized === 'zh_hans' ||
    normalized === 'zh') {
    return LANGUAGE_ZH_CN;
  }
  if (value === LANGUAGE_ZH_TW ||
    value === '繁體中文' ||
    normalized === 'traditional chinese' ||
    normalized === 'zh-tw' ||
    normalized === 'zh-hant' ||
    normalized === 'zh_hant') {
    return LANGUAGE_ZH_TW;
  }
  if (value === LANGUAGE_EN_US || normalized === 'english(us)' || normalized === 'en-us') {
    return LANGUAGE_EN_US;
  }
  if (value === LANGUAGE_EN_GB || normalized === 'english(uk)' || normalized === 'en-gb') {
    return LANGUAGE_EN_GB;
  }
  return LANGUAGE_SYSTEM;
}

