  ['请输入 Steam 发送的激活验证码以完成添加。', 'Enter the activation code sent by Steam to finish adding the authenticator.'],
  ['暂时无法读取设备详情，请保证验证器由当前设备生成且已更换支持的网络', 'Unable to load device details. Make sure the authenticator was generated on this device and switch to a supported network.'],
  ['Steam Guard、云同步与应用体验全面升级', 'Steam Guard, Cloud Sync, and App Experience Upgraded'],
  ['完整支持 Steam maFile 导入、扫码登录、交易确认及 maFile 备份导出。', 'Full support for Steam maFile import, QR sign-in, confirmations, and maFile backup export.'],
  ['支持登录尚未启用移动验证器的 Steam 账号，自动生成 maFile 并保存恢复码。', 'Sign in to Steam accounts without Mobile Authenticator to generate a maFile and save the recovery code.'],
  ['Steam 完整登录凭证与交易信息通过独立加密云表同步，通用令牌同步逻辑保持不变。', 'Complete Steam credentials and trade data sync through a separate encrypted cloud table without changing standard token sync.'],
  ['通用令牌与 Steam 完整数据分别显示上传、下载数量及同步状态。', 'Standard tokens and complete Steam data show separate upload, download, and sync status.'],
  ['新增全局背景显示、背景模糊调节和主题图片，二级页面可统一显示所选背景。', 'Adds global backgrounds, blur controls, and theme images across secondary pages.'],
  ['新增历史更新日志、AppGallery 评价入口及 SDA 开源项目说明。', 'Adds update history, an AppGallery review entry, and SDA open-source project information.'],
  ['完善 Steam 验证器工作流与主题体验', 'Improved Steam Authenticator Workflow and Themes'],
  ['补齐 Steam 登录验证、验证器激活、恢复码保存和本地 maFile 生成流程。', 'Completes Steam sign-in verification, authenticator activation, recovery-code saving, and local maFile generation.'],
  ['支持 Steam 二维码登录和交易确认，并优化风险告知与异常提示。', 'Supports Steam QR sign-in and confirmations with improved risk notices and error messages.'],
  ['新增自定义背景、预设主题图及全局沉浸光感设置。', 'Adds custom backgrounds, preset themes, and global immersive material settings.'],
  ['重构云同步并增强数据安全', 'Refactored Cloud Sync and Improved Data Security'],
  ['本机完整令牌与通用令牌云同步镜像分离。', 'Separates complete local token data from standard token cloud mirrors.'],
  ['优化手动推送、手动获取和自动同步，增加超时、状态反馈与失败恢复。', 'Improves manual push, pull, and auto sync with timeouts, status feedback, and recovery.'],
